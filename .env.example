# URL pública del backend (repositorio Proyectos-de-interfaces-SB).
# Si se deja vacía, el asistente funciona en modo sin conexión con los planes del catálogo.
EXPO_PUBLIC_API_URL=http://localhost:3001

# Modo reloj: muestra la interfaz a pantalla completa, sin el marco de simulación.
# Actívalo al compilar el APK para un smartwatch físico (también con ?watch=1 en la web).
EXPO_PUBLIC_WATCH_MODE=false
